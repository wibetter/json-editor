{
  "name": "json-editor",
  "workspaces": [
    "packages/json-schema-editor",
    "packages/json-editor",
    "packages/json-utils"
  ],
  "description": "提供 JSON 与 JSON Schema 的可视化编辑能力，内置 JSONEditor、SchemaEditor，可通过表单化界面维护 schema 和 json 数据，可用于支持组件与页面的配置可视化。",
  "keywords": [
    "jsonEditor",
    "schemaEditor",
    "json可视化工具",
    "schema可视化工具",
    "配置可视化工具"
  ],
  "author": "wibetter",
  "license": "MIT",
  "scripts": {
    "dev": "akfun dev",
    "build": "akfun build",
    "build2lib": "npm run build2lib --workspaces",
    "publish": "npm publish --workspaces",
    "format": "prettier --write \"packages/**/**/*.{js,jsx,ts,tsx,vue,scss,json}\"",
    "format2": "prettier --write \"demo.js\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "packages/**/**/*.{js,jsx,ts,tsx,vue,scss,json}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+http://git@github.com:wibetter/json-editor.git"
  },
  "bugs": {
    "url": "https://github.com/wibetter/json-editor/issues"
  },
  "publishConfig": {
    "registry": "https://www.npmjs.com/package/@wibetter/json-editor"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "akfun": "^5.2.5",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.9",
    "prettier": "^3.3.3",
    "@jridgewell/gen-mapping": "0.3.5"
  },
  "overrides": {
    "@rollup/plugin-alias": "^5.1.1"
  },
  "engines": {
    "node": ">= 16.0.0",
    "npm": ">= 8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8",
    "iOS >= 8",
    "Firefox >= 20",
    "Android > 4.4"
  ]
}